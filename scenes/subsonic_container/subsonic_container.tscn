[gd_scene load_steps=3 format=3 uid="uid://subsoniccontainer01"]

[ext_resource type="Script" path="res://scenes/subsonic_container/subsonic_container.gd" id="1_subcon"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_uwp12"]
bg_color = Color(0.130772, 0.130772, 0.130772, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[node name="SubsonicContainer" type="MarginContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_top = 29
script = ExtResource("1_subcon")

[node name="NoConnectionLabel" type="VBoxContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 4
theme_override_constants/separation = 16
alignment = 1

[node name="Label" type="Label" parent="NoConnectionLabel"]
layout_mode = 2
text = "Not Connected to Subsonic Server"
theme_override_font_sizes/font_size = 20
horizontal_alignment = 1

[node name="Label2" type="Label" parent="NoConnectionLabel"]
layout_mode = 2
text = "Go to Settings > Subsonic to configure your server connection."
horizontal_alignment = 1

[node name="ConnectSettingsBtn" type="Button" parent="NoConnectionLabel"]
unique_name_in_owner = true
layout_mode = 2
text = "Open Subsonic Settings"

[node name="ContentPage" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2

[node name="TopBar" type="HBoxContainer" parent="ContentPage"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="AlbumsBtn" type="Button" parent="ContentPage/TopBar"]
unique_name_in_owner = true
layout_mode = 2
text = "Albums"

[node name="LoadingLabel" type="Label" parent="ContentPage"]
unique_name_in_owner = true
layout_mode = 2
text = "Loading albums..."
horizontal_alignment = 1

[node name="ScrollContainer" type="ScrollContainer" parent="ContentPage"]
layout_mode = 2
size_flags_vertical = 3
follow_focus = true

[node name="AlbumsList" type="VBoxContainer" parent="ContentPage/ScrollContainer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="EmptyLabel" type="Label" parent="ContentPage/ScrollContainer"]
unique_name_in_owner = true
visible = false
layout_mode = 2
text = "No albums found on server"

[connection signal="pressed" from="NoConnectionLabel/ConnectSettingsBtn" to="." method="_on_connect_settings_btn_pressed"]
