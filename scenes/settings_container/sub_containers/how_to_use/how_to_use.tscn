[node name="Step1" type="Label" parent="ScrollContainer/Sections/GettingStarted/PanelContainer/MarginContainer/PanelContainer/MarginContainer/Body"]
layout_mode = 2
theme_type_variation = &"SongoSettingsLabel"
theme_override_font_sizes/font_size = 14
text = "1. Copy your music onto your device. I suggest making a 'MUSIC' folder next to 'ROMS' on your SD card. Sub-folders are fine, Songo#5 searches through all of them."
autowrap_mode = 3

[node name="Step2" type="Label" parent="ScrollContainer/Sections/GettingStarted/PanelContainer/MarginContainer/PanelContainer/MarginContainer/Body"]
layout_mode = 2
theme_type_variation = &"SongoSettingsLabel"
theme_override_font_sizes/font_size = 14
text = "2. Go to Settings > Data and Storage and press \"New Directory\". On Android you'll be asked to allow access to all files first; grant it, come back and press it again."
autowrap_mode = 3

[node name="Step3" type="Label" parent="ScrollContainer/Sections/GettingStarted/PanelContainer/MarginContainer/PanelContainer/MarginContainer/Body"]
layout_mode = 2
theme_type_variation = &"SongoSettingsLabel"
theme_override_font_sizes/font_size = 14
text = "3. Browse to your music folder and press \"Use this Directory\". Songo#5 will scan it and import every song it finds. Large libraries can take a little while."
autowrap_mode = 3

[node name="AddingMore" type="Label" parent="ScrollContainer/Sections/GettingStarted/PanelContainer/MarginContainer/PanelContainer/MarginContainer/Body"]
layout_mode = 2
theme_type_variation = &"SongoSettingsLabel"
theme_override_font_sizes/font_size = 14
text = "Adding more music later: with Auto Scan enabled (Data and Storage), new files are picked up each time the app starts. With it disabled, run \"Indexed Music Data - Rebuild\" after adding music."
autowrap_mode = 3

[node name="Playlists" type="Label" parent="ScrollContainer/Sections/GettingStarted/PanelContainer/MarginContainer/PanelContainer/MarginContainer/Body"]
layout_mode = 2
theme_type_variation = &"SongoSettingsLabel"
theme_override_font_sizes/font_size = 14
text = "Any .m3u playlist files inside your music directories are imported automatically too."
autowrap_mode = 3

