{
	"name": "Songo Classic",
	"version": "0.12",
	"author": "Riley",
	"description": "Original Songo#5 theme, based on minimalism and being user friendly.",
	"godot_theme_path": "/theme.tres",
	"components": {
		"background_root": "background_root/background_root.tscn",
		"main_menu": {
			"setting": "main_menu_layout",
			"scenes": {
				"b": "main_menu_2/main_menu_2.tscn",
				"c": "main_menu_3/main_menu_3.tscn",
				"d": "main_menu_4/main_menu_4.tscn"
			}
		},
		"header": "header/header.tscn",
		"main_song_view": "main_song_view/main_song_view.tscn",
		"footer": "footer/footer.tscn",
		"song_follow": "song_follow/song_follow.tscn",
		"collection_button": "collection_button/collection_button.tscn",
		"collection_header": "collection_header/collection_header.tscn"
	},
	"collection_options": {
		"vertical_layout": true,
		"list_top_fade": 0,
		"list_bottom_fade": 16,
	},
	"tags": [
		"minimal",
		"og",
		"customizable"
	],
	"settings": {
		"songo_background_color": {
			"values": [
				"48486d", 
				"84233b",
				"215a30", 
				"562b90",
				"7c2a00",
				"004988", 
				"d57200", 
				"5865F2",
				"cc1111", 
				"FB6F92",
				"777",
				"555",
			],
			"labels": [
				"Grayish Blue",
				"Purpley",
				"Emerald Green",
				"Purpley Blue",
				"Burnt Orange",
				"Another Blue",
				"Pumpkin Spice",
				"Voice Chat Color",
				"Red-bernic",
				"Pink?",
				"Oops! No color!",
				"The Grid"
			],
			"default": "48486d",
			"display_name": "Background Color",
			"dependents": ["background_root"]
		},
		"main_menu_layout": {
			"values": ["c", "d", "b"],
			"labels": ["A", "B", "C"],
			"default": "c",
			"display_name": "Main Menu Layout",
			"dependents": []
		},
		"main_menu_fit": {
			"values": ["width", "height"],
			"labels": ["Width", "Height"],
			"default": "width",
			"display_name": "Menu Fit",
			"dependents": [],
			"visible_when": { "main_menu_layout": ["c"] }
		},
		"main_menu_gap": {
			"values": [2, 4, 8, 12, 16, 20, 24, 28, 32],
			"labels": ["2", "4", "8", "12", "16", "20", "24", "28", "32"],
			"default": 16,
			"display_name": "Main Menu Gap",
			"dependents": ["main_menu"]
		},
		"main_menu_y_margin": {
			"values": [0, 8, 16, 24, 32, 40, 48, 56, 64],
			"labels": ["0", "8", "16", "24", "32", "40", "48", "56", "64"],
			"default": 0,
			"display_name": "Menu Y Margin",
			"dependents": ["main_menu"]
		},
		"main_menu_label_style": {
			"values": ["inline", "on_focus"],
			"labels": ["Inline", "On Focus"],
			"default": "inline",
			"display_name": "Menu Label Style",
			"dependents": ["main_menu"]
		},
		"crt_mode": {
			"values": [true, false],
			"default": false,
			"display_name": "CRT Mode",
			"dependents": ["background_root"]
		},
	}
}
