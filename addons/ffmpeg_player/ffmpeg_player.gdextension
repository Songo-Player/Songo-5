[configuration]
entry_symbol = "ffmpeg_library_init"
compatibility_minimum = 4.3

[libraries]
android.debug.arm64   = "bin/libffmpegplayer.android.template_debug.arm64.so"
android.release.arm64 = "bin/libffmpegplayer.android.template_release.arm64.so"
linux.debug.x86_64 = "bin/libffmpegplayer.linux.template_debug.x86_64.so"
arm64 = "bin/libffmpegplayer.linux.template_release.arm64.so"
linux.arm64 = "bin/libffmpegplayer.linux.template_release.arm64.so"
