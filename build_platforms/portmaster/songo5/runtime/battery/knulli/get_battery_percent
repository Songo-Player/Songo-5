#!/bin/sh

# Knulli Scarab onwards: knulli-battery-check prefers batteryplus's
# /tmp/battery.percent, which is also what the ES homepage shows
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/../default/battery_common.sh"

print_percent "$(knulli-battery-check capacity 2>/dev/null | tr -d '[:space:]')" && exit 0

exec sh "$SCRIPT_DIR/../default/get_battery_percent"
