#!/bin/sh

# ROCKNIX's batteryplus daemon writes a voltage based percentage here, the
# same value ES shows (battery_percent in 001-functions reads it too)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/../default/battery_common.sh"

print_percent "$(cat /tmp/battery.percent 2>/dev/null | tr -d '[:space:]')" && exit 0

for DIR in /sys/class/power_supply/[Bb][Aa][Tt]*; do
    [ -d "$DIR" ] || continue
    print_percent "$(cat "$DIR/capacity" 2>/dev/null | tr -d '[:space:]')" && exit 0
done

exec sh "$SCRIPT_DIR/../default/get_battery_percent"
