#!/bin/bash

# $1 is 0-255, scaled to the panel's range for sysfs backlights
VAL="$1"

case "$VAL" in
  ''|*[!0-9]*) exit 1 ;;
esac
[ "$VAL" -gt 255 ] && VAL=255

if [[ "$BL_TYPE" == "TYPE1" ]]; then
  echo "$BL_COMMAND" > "$SYSFS_BL_COMMAND"
  echo "$BL_NAME" > "$SYSFS_BL_NAME"
  echo "$VAL" > "$SYSFS_BL_PARAM"
  echo "1" > "$SYSFS_BL_START"
elif [[ "$BL_TYPE" == "TYPE2" ]]; then
  BL_DIR="$(dirname "$SYSFS_BL_BRIGHTNESS")"
  BL_MAX="$(cat "$BL_DIR/max_brightness" 2>/dev/null)"
  case "$BL_MAX" in
    ''|*[!0-9]*|0) BL_MAX=255 ;;
  esac

  RAW=$(( (VAL * BL_MAX + 127) / 255 ))
  # Don't let a small non-zero value round down to backlight off
  [ "$VAL" -gt 0 ] && [ "$RAW" -eq 0 ] && RAW=1

  echo "$RAW" > "$SYSFS_BL_BRIGHTNESS"
  # Also wake screen just in case...
  [ -e "$BL_DIR/bl_power" ] && echo "0" > "$BL_DIR/bl_power"
fi
